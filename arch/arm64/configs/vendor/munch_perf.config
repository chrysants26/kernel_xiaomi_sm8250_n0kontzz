#
# Performance-focused kernel config fragment for Poco F4 (munch)
# Device: Poco F4 (munch) - Snapdragon 870 (SM8250-AC / Kona)
# Focus: Maximum performance, responsiveness, gaming
#

#=====================================================
# CPU & SCHEDULER - Performance Governor & Scheduling
#=====================================================

# Performance CPU governor as default
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set

# Keep schedutil available for dynamic switching
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# CPU frequency transition stats (useful for monitoring, low overhead)
CONFIG_CPU_FREQ_STAT=y

# Enable CPU boost for input events (improves touch responsiveness)
CONFIG_CPU_INPUT_BOOST=y

# HMP (Heterogeneous Multi-Processing) scheduling optimizations
CONFIG_SCHED_HMP=y
CONFIG_SCHED_HMP_CSTATE_AWARE=y

# Core control for big.LITTLE
CONFIG_CORE_CTL=y

# Schedtune for boosting tasks
CONFIG_CGROUP_SCHEDTUNE=y

# RT (Real-Time) scheduler support for low latency
CONFIG_RT_GROUP_SCHED=y

#=====================================================
# PREEMPTION - Full preemption for responsiveness
#=====================================================

# Full preemption model for lowest latency
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set

#=====================================================
# TIMER - Higher timer frequency for smoother UI
#=====================================================

# 300Hz timer (good balance between performance and battery)
# For pure performance, 1000Hz is better but drains more battery
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ=300

# NOHZ (tickless kernel) for idle power savings
CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y

#=====================================================
# MEMORY - Optimizations for RAM performance
#=====================================================

# Transparent Huge Pages for improved memory performance
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Memory compaction
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# KSM (Kernel Samepage Merging) - disable for performance
# CONFIG_KSM is not set

# Defragmentation for memory performance
CONFIG_CLEANCACHE=y

#=====================================================
# I/O SCHEDULER - Best I/O schedulers for flash storage
#=====================================================

# Enable FIOPS I/O scheduler (great for flash/eMMC/UFS)
CONFIG_IOSCHED_FIOPS=y

# Enable Maple I/O scheduler (good for general performance)
CONFIG_IOSCHED_MAPLE=y

# Enable SIO/Simple I/O scheduler
CONFIG_IOSCHED_SIO=y

# Keep BFQ for heavy I/O workloads
CONFIG_IOSCHED_BFQ=y

# Keep the default MQ-deadline
CONFIG_MQ_IOSCHED_DEADLINE=y

# Kyber I/O scheduler (good for NVMe/UFS)
CONFIG_IOSCHED_KYBER=y

#=====================================================
# NETWORKING - TCP & Network performance
#=====================================================

# BBR TCP congestion control (better throughput than cubic)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Keep cubic available
CONFIG_TCP_CONG_CUBIC=y

# Network optimizations
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

#=====================================================
# FILESYSTEMS - Performance for common FS types
#=====================================================

# F2FS optimizations (main filesystem for Android)
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_F2FS_FS_COMPRESSION=y

# Ext4 optimizations
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

#=====================================================
# DEBUG - DISABLE ALL DEBUG for performance
#=====================================================

# Disable kernel debugging (significant performance gain)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_PI_LIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_DEBUG_NOTIFIERS is not set
# CONFIG_DEBUG_CREDENTIALS is not set
# CONFIG_DEBUG_RODATA is not set
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_DEBUG_SLAB is not set
# CONFIG_DEBUG_WQ_FORCE_RR_CPU is not set
# CONFIG_DEBUG_TIMEKEEPING is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_VM_VMACACHE is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEBUG_PER_CPU_MAPS is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_FTRACE is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_IRQSOFF_TRACER is not set
# CONFIG_SCHED_TRACER is not set
# CONFIG_KPROBES is not set

# Disable KASAN (huge performance hit)
# CONFIG_KASAN is not set

# Disable stack validation overhead
# CONFIG_STACK_VALIDATION is not set

#=====================================================
# SECURITY - Minimal overhead security
#=====================================================

# Keep SELinux (required for Android) but disable debug
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_DEBUG is not set

# Disable unused security modules
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_YAMA is not set
# CONFIG_SECURITY_SAFESETID is not set

#=====================================================
# MISCELLANEOUS PERFORMANCE TUNING
#=====================================================

# CRC32 hardware acceleration
CONFIG_CRC32_SELFTEST=y

# Optimized string/memory functions
CONFIG_ARCH_USE_BUILTIN_BSWAP=y

# Jump label optimization (reduces branch misprediction)
CONFIG_JUMP_LABEL=y

# Per-CPU page cache for reduced lock contention
CONFIG_MMU_GATHER_RCU_TABLE_FREE=y

# VMAP stack (better stack overflow protection with minimal overhead)
CONFIG_VMAP_STACK=y

# Disable unused subsystems
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_EARJACK_DEBUGGER is not set
# CONFIG_CORESIGHT is not set

# Enable KCPUIDLE for better idle state management
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y

# QCOM specific performance
CONFIG_QCOM_CPUIDLE=y
CONFIG_QCOM_LPM=y

# GPU/Adreno performance
CONFIG_MSM_ADRENO_DEV=y
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"
CONFIG_QCOM_ADRENO_GOVERNOR_TZ=y

# Disable unused modules that add overhead
# CONFIG_MODULES is not set

# Kernel compression - LZ4 for fastest boot
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set

# Initramfs compression - LZ4
CONFIG_INITRAMFS_COMPRESSION_LZ4=y
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set

# Block layer optimizations
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# ZRAM with LZ4 for fast swap compression
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZSMALLOC=y
